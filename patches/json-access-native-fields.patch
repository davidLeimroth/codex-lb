             "level": record.levelname,
             "logger": record.name,
             "type": "access",
-            "client": getattr(record, "client_addr", None),
-            "request": getattr(record, "request_line", None),
-            "status": getattr(record, "status_code", None),
+            "client": client,
+            "request": request,
+            "status": status,
         }
         return json.dumps(log_entry, default=str)
 
